-- ========== FUNÇÃO PARA ENCONTRAR JOGADOR ==========
local function encontrarJogador(nome)
    for _, plr in ipairs(Players:GetPlayers()) do
        if string.lower(plr.Name) == string.lower(nome) or string.lower(plr.DisplayName) == string.lower(nome) then
            return plr
        end
    end
    return nil
end

-- ========== FUNÇÃO DE NOTIFICAÇÃO ==========
local function mostrarNotificacao(texto, cor)
    local Notif = Instance.new("TextLabel")
    Notif.Parent = ScreenGui
    Notif.Text = texto
    Notif.Size = UDim2.new(0, 300, 0, 35)
    Notif.Position = UDim2.new(0.5, -150, 0.92, 0)
    Notif.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    Notif.TextColor3 = cor or Color3.fromRGB(255, 255, 255)
    Notif.Font = Enum.Font.SourceSansBold
    Notif.TextScaled = true
    Notif.BorderSizePixel = 0

    local NotifCorner = Instance.new("UICorner")
    NotifCorner.CornerRadius = UDim.new(0, 10)
    NotifCorner.Parent = Notif

    game:GetService("TweenService"):Create(Notif, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -150, 0.86, 0)}):Play()
    task.delay(2.5, function()
        game:GetService("TweenService"):Create(Notif, TweenInfo.new(0.4), {Position = UDim2.new(0.5, -150, 0.96, 0)}):Play()
        task.delay(0.4, function() Notif:Destroy() end)
    end)
end

-- ========== FLING SUPER OP (Instantâneo + Auto-Para) ==========
local function flingSuperOP(targetPlayer)
    if not targetPlayer.Character then
        mostrarNotificacao("❌ Jogador sem personagem!", Color3.fromRGB(255, 200, 0))
        return
    end

    local rootPart = targetPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not rootPart then
        mostrarNotificacao("❌ HumanoidRootPart não encontrado!", Color3.fromRGB(255, 200, 0))
        return
    end

    -- Remove qualquer BodyVelocity anterior
    for _, v in ipairs(rootPart:GetChildren()) do
        if v:IsA("BodyVelocity") then
            v:Destroy()
        end
    end

    -- Cria BodyVelocity com força MÁXIMA (instantâneo)
    local bodyVel = Instance.new("BodyVelocity")
    bodyVel.Velocity = Vector3.new(
        math.random(-2000, 2000),  -- Horizontal extremo
        math.random(800, 1500),    -- Vertical altíssima
        math.random(-2000, 2000)   -- Horizontal extremo
    )
    bodyVel.MaxForce = Vector3.new(99999, 99999, 99999) -- Força ilimitada
    bodyVel.Parent = rootPart

    mostrarNotificacao("🚀 " .. targetPlayer.Name .. " foi lançado!", Color3.fromRGB(255, 100, 0))

    -- ========== PARA AUTOMATICAMENTE DEPOIS DE 0.1 SEGUNDOS ==========
    task.delay(0.1, function()
        if bodyVel and bodyVel.Parent then
            bodyVel:Destroy()
        end
        mostrarNotificacao("✅ Fling executado! Parou automaticamente.", Color3.fromRGB(0, 255, 100))
    end)
end

-- ========== EVENTO DO BOTÃO ==========
BotaoFling.MouseButton1Click:Connect(function()
    local nome = TextBoxNick.Text
    if nome == "" then
        mostrarNotificacao("❌ Digite o nick do jogador!", Color3.fromRGB(255, 200, 0))
        return
    end

    local target = encontrarJogador(nome)
    if not target then
        mostrarNotificacao("❌ Jogador não encontrado!", Color3.fromRGB(255, 200, 0))
        return
    end

    if target == player then
        mostrarNotificacao("❌ Você não pode se flingar!", Color3.fromRGB(255, 0, 0))
        return
    end

    flingSuperOP(target)
end)

